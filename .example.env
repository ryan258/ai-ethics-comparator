OPENROUTER_API_KEY="sk-or-your-key-here"
APP_BASE_URL=http://localhost:8000
# Loopback by default. Changing this exposes an unauthenticated application.
APP_HOST=127.0.0.1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DEFAULT_MODEL and ANALYST_MODEL are derived from models.json when unset
# DEFAULT_MODEL=provider/model-name
# ANALYST_MODEL=provider/model-name
AI_CHOICE_INFERENCE_ENABLED=false
REPORT_THEME=dark
MAX_ITERATIONS=50

APP_NAME="AI Ethics Comparator"
AI_CONCURRENCY_LIMIT=2
AI_MAX_RETRIES=2
AI_RETRY_DELAY=2
AI_REQUEST_TIMEOUT=120
